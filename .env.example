# Every setting, with its default. Copy to .env for local overrides; in deployments use environment variables or a
# secret store. Nested settings use a double underscore.

FAA_ENVIRONMENT=development                 # development | test | production (production refuses unsafe settings)
FAA_DATABASE_URL=sqlite+aiosqlite:///./fraud_audit_assist.db
# FAA_DATABASE_URL=postgresql+psycopg://faa:faa@localhost:5432/faa
FAA_PACK_DIR=packs/investor_portal
# FAA_RULES_VERSION=v2                      # defaults to the pack's default_rules

# API keys: ingest (source systems) and analyst (people). Unset means open, allowed outside production only.
# FAA_INGEST_API_KEY=
# FAA_ANALYST_API_KEY=

FAA_LOG_LEVEL=INFO
FAA_LOG_JSON=true
# FAA_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# LLM
FAA_LLM__PROVIDER=fake                      # fake | openai | azure_openai | anthropic
FAA_LLM__MODEL=gpt-4.1-mini                 # the deployment name for Azure OpenAI
# FAA_LLM__API_KEY=
# FAA_LLM__ENDPOINT=https://<resource>.openai.azure.com/
FAA_LLM__API_VERSION=2024-10-21
FAA_LLM__TIMEOUT_SECONDS=30
FAA_LLM__MAX_RETRIES=2
# FAA_LLM__REQUESTS_PER_SECOND=2
FAA_LLM__INPUT_PRICE_PER_1K=0
FAA_LLM__OUTPUT_PRICE_PER_1K=0
FAA_LLM__MAX_TOOL_ROUNDS=6
# FAA_LLM__FALLBACK_PROVIDER=anthropic
# FAA_LLM__FALLBACK_MODEL=claude-haiku-5-5
# FAA_LLM__FALLBACK_API_KEY=

# Budget guard
FAA_INVESTIGATION__ENABLED=true
FAA_INVESTIGATION__DAILY_LIMIT=20
FAA_INVESTIGATION__QUEUE_CAPACITY=1000
FAA_INVESTIGATION__MAX_ATTEMPTS=2

# CLI client (faa scenario post / dataset post)
# FAA_API_URL=http://127.0.0.1:8000
# FAA_CLIENT_API_KEY=                      # ingest key, for posting events
# FAA_CLIENT_ANALYST_KEY=                  # analyst key, for seeding Confirmed Frauds
